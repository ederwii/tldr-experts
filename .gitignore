# dependencies
node_modules/

# framework runtime (machine-local, regenerated)
.tldrx/runtime/
.tldrx/cache/

# per-run caches inside work folders
tldrx-work/**/.cache/
tldrx-work/**/*.tmp

# the previous version of a state file, kept by every atomic save
tldrx-work/**/*.bak
.tldrx/memory/*.bak

# build output
dist/
*.tsbuildinfo

# `npm pack` / `npm publish --dry-run` output. Untracked, but merge-wave.sh refuses on
# ANY porcelain line, so one stray pack used to block the NEXT agent's merge (#45).
*.tgz

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# local overrides
.env
.env.local
.claude/settings.local.json

# `tldrx install --claude` backs settings.json up before merging into it.
# The framework's own repo needs the same line it writes into a user's workspace.
.claude/settings.json.bak-tldrx-*

# docs-site (the public VitePress site). Its build output and the changelog page it
# generates from CHANGELOG.md at build time — never a second copy anyone maintains.
docs-site/.vitepress/dist/
docs-site/.vitepress/cache/
docs-site/reference/changelog.md
