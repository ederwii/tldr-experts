{
  "name": "tldr-experts",
  "version": "0.6.1",
  "description": "tldr-experts: an evidence-first, file-based AI development framework - five stages, a gate on every one, and every claim cited or refused. Installs the `tldrx` (and `tldr-experts`) command. Beta.",
  "license": "MIT",
  "author": "Alan Martinez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ederwii/tldr-experts.git"
  },
  "homepage": "https://github.com/ederwii/tldr-experts#readme",
  "bugs": {
    "url": "https://github.com/ederwii/tldr-experts/issues"
  },
  "keywords": [
    "ai",
    "workflow",
    "claude-code",
    "agentic",
    "developer-experience",
    "tldr",
    "experts",
    "cli"
  ],
  "type": "module",
  "bin": {
    "tldrx": "dist/tldrx.js",
    "tldr-experts": "dist/tldrx.js"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "env.yml",
    "plugin",
    "stages",
    "templates",
    "workflows"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "docs:dev": "cd docs-site && bun install && bun run dev",
    "docs:build": "cd docs-site && bun install --frozen-lockfile && bun run build",
    "typecheck": "tsc --noEmit",
    "doctor": "bun bin/tldrx.ts doctor",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
